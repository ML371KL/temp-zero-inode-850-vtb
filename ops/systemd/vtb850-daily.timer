[Unit]
Description=ВТБ 850 · таймер суточного прогона

[Timer]
# Время — ops/schedule.json (daily): строку OnCalendar вписывает
# `python ops/tools/schedule.py --write`, руками она не правится. По будням
# вечером, после суточных тактов соседних панелей: сервер общий, и две сборки
# разом растягивают обе. Основная сессия MOEX закрывается в 18:40 МСК, ISS
# отдаёт итоги дня; кривая бескупонной доходности — тем же вечером. Такт
# кончается до полуночи по Москве — дата оценки та же. В выходные новых
# торговых данных нет, и прогон дал бы тот же выпуск (выпуск с тем же хэшем
# повторно не публикуется).
OnCalendar=Mon..Fri *-*-* 19:50:00 UTC
# Разброс, чтобы не бить по ISS ровно в ту же секунду, что соседние панели.
RandomizedDelaySec=300
# Пропущенный из-за выключенной машины прогон догоняется при старте.
Persistent=true
Unit=vtb850-daily.service

[Install]
WantedBy=timers.target
