[Unit]
Description=ВТБ 850 · таймер дозора релизов (будни, каждые 10 минут в окне дня релиза)

[Timer]
# Окно и шаг — ops/schedule.json (release-watch: window_msk, every_min): строки
# OnCalendar вписывает `python ops/tools/schedule.py --write`, руками они не
# правятся. Строк две: запись systemd «ЧЧ:ММ/шаг» считает минуты внутри часа,
# и первый, неполный час окна идёт своей строкой. Месячные результаты по МСФО
# и квартальную отчётность эмитент выкладывает около 10:00 по Москве, изредка —
# к полудню; то же окно называет справочный ключ schedule.watch_window_msk
# в data/indicators/sources.yaml. Минуты — мимо проверок соседних банков
# семейства. Дни релиза выбирает сам такт (тихая проверка окна по календарю
# индикаторов): вне окна — выход без строки, поэтому ширина окна почти
# бесплатна.
OnCalendar=Mon..Fri *-*-* 06:46/10:00 UTC
OnCalendar=Mon..Fri *-*-* 07..10:06/10:00 UTC
RandomizedDelaySec=30
AccuracySec=30s
# Persistent не нужен: пропущенная проверка ничего не теряет — следующая через
# 10 минут, а суточный такт вечером соберёт всё принятое.
Unit=vtb850-release-watch.service

[Install]
WantedBy=timers.target
